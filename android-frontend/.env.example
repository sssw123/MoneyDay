# Browser development uses the Vite /api proxy when unset.
# Android emulator debug APK: use http://10.0.2.2:8080/api with --mode android-debug.
# Physical device debug APK: replace 10.0.2.2 with the computer's LAN IP.
# Release APK: use an HTTPS URL and --mode android-release.
VITE_API_BASE_URL=https://your-moneyday-host.example/api
